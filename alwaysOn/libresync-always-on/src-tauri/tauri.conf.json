{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LibreSyncAlwaysOn",
  "version": "0.6.1",
  "identifier": "com.codedbydan.libresync.alwayson",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "LibreSync AlwaysOn", "width": 1050, "height": 780, "minWidth": 700, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; script-src 'self'; style-src 'self'" }
  },
  "bundle": { "active": true, "icon": ["icons/icon.png"] }
}
