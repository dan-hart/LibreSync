[Unit]
Description=LibreSyncAlwaysOn daemon
After=network-online.target

[Service]
Type=simple
# Secure OS keys are the default. Explicit --file-keys is optional for headless use.
ExecStart=/usr/local/bin/libresync-alwayson-daemon --root %h/.local/share/libresync/managed-v1 serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
