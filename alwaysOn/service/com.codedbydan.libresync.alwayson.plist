<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.codedbydan.libresync.alwayson</string>
    <key>ProgramArguments</key>
    <array>
      <string>/usr/local/bin/libresync-alwayson-daemon</string>
      <string>--auto-approve</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/libresync-alwayson.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/libresync-alwayson.err.log</string>
  </dict>
</plist>
