# systemd user unit for the LibreSync always-on daemon.
# Install: see contrib/README.md
[Unit]
Description=LibreSync always-on sync daemon
Documentation=https://github.com/dan-hart/LibreSync
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust the path if you installed the binary elsewhere (e.g. ~/.cargo/bin).
ExecStart=%h/.local/bin/libresync-alwayson-daemon --root %h/.local/share/libresync/managed-v1 serve
# Secure Secret Service keys are the default. --file-keys is an explicit
# operator opt-in for unattended installations; never add automatic approval.
Restart=on-failure
RestartSec=5
# Keep restarting on flapping networks instead of giving up.
StartLimitIntervalSec=0
Environment=RUST_LOG=info
# Hardening (all optional; loosen if your adapters live outside $HOME).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/libresync
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=default.target
